  "verses": [
    {
      "verse_id": "MAT.17.1",
      "verse": 1,
      "text": "Khỏi sáu ngày, Đức Chúa Jêsus đem Phi-e-rơ, Gia-cơ, và Giăng là em Gia-cơ, cùng Ngài đi tẽ lên núi cao.",
      "poetic_lines": null,
      "is_paragraph_start": true,
      "is_paragraph_end": false,
      "is_stanza_break": false,
      "is_omitted_in_critical_text": false,
      "section_headings": [
        {
          "type": "section_scope",
          "text": "(Mac 9:2-13; Lu 9:28-36)"
        },
        {
          "type": "section_title",
          "text": "Sự hóa hình"
        }
      ],
      "cross_references": [
        {
