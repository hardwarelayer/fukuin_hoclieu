      "verse_id": "PSA.23.1",
      "verse": 1,
      "text": "Đức Giê-hô-va là Đấng chăn giữ tôi; tôi sẽ chẳng thiếu thốn gì.",
      "poetic_lines": null,
      "is_paragraph_start": true,
      "is_paragraph_end": true,
      "is_stanza_break": false,
      "is_omitted_in_critical_text": false,
      "section_headings": [
        {
          "type": "section_title",
          "text": "Đức Giê-hô-va là Đấng chăn giữ tác giả"
        }
      ],
      "cross_references": [],
      "textual_footnotes": [],
      "verification_status": "LEXICAL_MATCH_2_OF_3"
    },
    {
      "verse_id": "PSA.23.2",
      "verse": 2,
      "text": "Ngài khiến tôi an nghỉ nơi đồng cỏ xanh tươi\nDẫn tôi đến mé nước bình tịnh.",
      "poetic_lines": [
        "Ngài khiến tôi an nghỉ nơi đồng cỏ xanh tươi",
        "Dẫn tôi đến mé nước bình tịnh."
      ],
      "is_paragraph_start": true,
      "is_paragraph_end": true,
      "is_stanza_break": false,
