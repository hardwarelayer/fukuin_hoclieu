    {
      "verse_id": "MAT.17.6",
      "verse": 6,
      "text": "Khi môn đồ nghe tiếng ấy, thì té sấp mặt xuống đất, và sợ hãi lắm.",
      "poetic_lines": null,
      "is_paragraph_start": false,
      "is_paragraph_end": false,
      "is_stanza_break": false,
      "is_omitted_in_critical_text": false,
      "section_headings": [],
      "cross_references": [],
      "textual_footnotes": [],
      "verification_status": "UNANIMOUS_3_OF_3"
    },
    {
      "verse_id": "MAT.17.7",
      "verse": 7,
      "text": "Song Đức Chúa Jêsus lại gần, rờ môn đồ mà phán rằng: Hãy đứng dậy, đừng sợ!",
      "poetic_lines": null,
      "is_paragraph_start": false,
      "is_paragraph_end": false,
      "is_stanza_break": false,
      "is_omitted_in_critical_text": false,
      "section_headings": [],
      "cross_references": [],
      "textual_footnotes": [],
      "verification_status": "UNANIMOUS_3_OF_3"
    },
    {
      "verse_id": "MAT.17.8",
      "verse": 8,
      "text": "Môn đồ bèn ngửa mặt lên, thì chỉ thấy một mình Đức Chúa Jêsus mà thôi.",
      "poetic_lines": null,
      "is_paragraph_start": false,
      "is_paragraph_end": true,
      "is_stanza_break": false,
      "is_omitted_in_critical_text": false,
      "section_headings": [],
      "cross_references": [],
      "textual_footnotes": [],
      "verification_status": "UNANIMOUS_3_OF_3"
    },
    {
      "verse_id": "MAT.17.9",
      "verse": 9,
      "text": "Đang khi Đức Chúa Jêsus và môn đồ ở trên núi xuống, thì Ngài ra lịnh cấm rằng: Sự các ngươi đã thấy chớ thuật lại cùng ai, cho đến khi Con người từ kẻ chết sống lại.",
      "poetic_lines": null,
      "is_paragraph_start": true,
      "is_paragraph_end": false,
      "is_stanza_break": false,
      "is_omitted_in_critical_text": false,
      "section_headings": [],
      "cross_references": [],
      "textual_footnotes": [],
      "verification_status": "UNANIMOUS_3_OF_3"
    },
    {
      "verse_id": "MAT.17.10",
      "verse": 10,
      "text": "Môn đồ hỏi Ngài rằng: Vậy thì sao các thầy thông giáo nói rằng Ê-li phải đến trước?",
      "poetic_lines": null,
      "is_paragraph_start": false,
      "is_paragraph_end": false,
      "is_stanza_break": false,
      "is_omitted_in_critical_text": false,
      "section_headings": [],
      "cross_references": [
        {
          "raw": "Ma 4:5",
          "target_usfm": "MAL",
          "target_chapter": 4,
          "target_verses": "5"
        }
      ],
      "textual_footnotes": [],
      "verification_status": "UNANIMOUS_3_OF_3"
    },
    {
      "verse_id": "MAT.17.11",
      "verse": 11,
      "text": "Đức Chúa Jêsus đáp rằng: Thật Ê-li phải đến mà sửa lại mọi việc.",
      "poetic_lines": null,
      "is_paragraph_start": false,
      "is_paragraph_end": false,
      "is_stanza_break": false,
      "is_omitted_in_critical_text": false,
      "section_headings": [],
      "cross_references": [],
      "textual_footnotes": [],
      "verification_status": "UNANIMOUS_3_OF_3"
    },
    {
      "verse_id": "MAT.17.12",
      "verse": 12,
      "text": "Nhưng ta phán cùng các ngươi rằng: Ê-li đã đến rồi, và người ta không nhận biết, song họ lại xử với người theo ý muốn mình; Con người phải chịu khốn khổ bởi họ cũng như vậy.",
      "poetic_lines": null,
      "is_paragraph_start": false,
      "is_paragraph_end": false,
      "is_stanza_break": false,
      "is_omitted_in_critical_text": false,
      "section_headings": [],
      "cross_references": [
        {
          "raw": "Mat 11:14",
          "target_usfm": "MAT",
          "target_chapter": 11,
          "target_verses": "14"
        }
      ],
      "textual_footnotes": [],
      "verification_status": "UNANIMOUS_3_OF_3"
    },
    {
      "verse_id": "MAT.17.13",
      "verse": 13,
      "text": "Môn đồ bèn hiểu rằng Ngài nói đó là nói về Giăng Báp-tít.",
      "poetic_lines": null,
      "is_paragraph_start": false,
      "is_paragraph_end": true,
      "is_stanza_break": false,
      "is_omitted_in_critical_text": false,
      "section_headings": [],
      "cross_references": [],
      "textual_footnotes": [],
      "verification_status": "UNANIMOUS_3_OF_3"
    },
    {
      "verse_id": "MAT.17.14",
      "verse": 14,
      "text": "Khi Đức Chúa Jêsus và môn đồ đã trở lại cũng đoàn dân, thì có một người đến gần, quì trước mặt Ngài,",
      "poetic_lines": null,
      "is_paragraph_start": true,
      "is_paragraph_end": false,
      "is_stanza_break": false,
      "is_omitted_in_critical_text": false,
      "section_headings": [
        {
          "type": "section_scope",
          "text": "(Mac 9:14-29; Lu 9:37-43a)"
        },
        {
          "type": "section_title",
          "text": "Chúa chữa bệnh phong điên"
        }
      ],
      "cross_references": [],
      "textual_footnotes": [],
      "verification_status": "MAJORITY_HTTLVN_2_OF_3"
    },
    {
      "verse_id": "MAT.17.15",
      "verse": 15,
      "text": "mà thưa rằng: Lạy Chúa, xin Chúa thương đến con trai tôi! Vì nó mắc bệnh phong điên, phải chịu đau đớn quá; thường khi té vào lửa, và té xuống nước.",
      "poetic_lines": null,
      "is_paragraph_start": false,
      "is_paragraph_end": false,
      "is_stanza_break": false,
      "is_omitted_in_critical_text": false,
      "section_headings": [],
      "cross_references": [],
      "textual_footnotes": [],
      "verification_status": "MAJORITY_HTTLVN_2_OF_3"
    },
    {
      "verse_id": "MAT.17.16",
      "verse": 16,
      "text": "Tôi đã đem nó cho môn đồ Chúa, nhưng chữa không được.",
      "poetic_lines": null,
      "is_paragraph_start": false,
      "is_paragraph_end": false,
      "is_stanza_break": false,
      "is_omitted_in_critical_text": false,
      "section_headings": [],
      "cross_references": [],
      "textual_footnotes": [],
      "verification_status": "UNANIMOUS_3_OF_3"
    },
    {
      "verse_id": "MAT.17.17",
      "verse": 17,
      "text": "Đức Chúa Jêsus đáp rằng: Hỡi dòng dõi không tin và gian tà kia, ta sẽ ở với các ngươi cho đến chừng nào? Ta sẽ nhịn nhục các ngươi cho đến khi nào? Hãy đem con đến đây cho ta.",
      "poetic_lines": null,
      "is_paragraph_start": false,
      "is_paragraph_end": false,
      "is_stanza_break": false,
      "is_omitted_in_critical_text": false,
      "section_headings": [],
      "cross_references": [],
      "textual_footnotes": [],
      "verification_status": "UNANIMOUS_3_OF_3"
    },
    {
      "verse_id": "MAT.17.18",
      "verse": 18,
      "text": "Rồi Đức Chúa Jêsus quở trách quỉ, quỉ liền ra khỏi đứa trẻ, và từ giờ đó đứa trẻ được lành.",
      "poetic_lines": null,
      "is_paragraph_start": false,
      "is_paragraph_end": true,
      "is_stanza_break": false,
      "is_omitted_in_critical_text": false,
      "section_headings": [],
      "cross_references": [],
      "textual_footnotes": [],
      "verification_status": "UNANIMOUS_3_OF_3"
    },
    {
      "verse_id": "MAT.17.19",
      "verse": 19,
      "text": "Môn đồ bèn đến gần Đức Chúa Jêsus, mà hỏi riêng rằng: Vì cớ gì chúng tôi không đuổi quỉ ấy được?",
      "poetic_lines": null,
      "is_paragraph_start": true,
      "is_paragraph_end": false,
      "is_stanza_break": false,
      "is_omitted_in_critical_text": false,
      "section_headings": [],
      "cross_references": [],
      "textual_footnotes": [],
      "verification_status": "UNANIMOUS_3_OF_3"
    },
    {
      "verse_id": "MAT.17.20",
      "verse": 20,
      "text": "Ngài đáp rằng: Ấy là tại các ngươi ít đức tin: Vì ta nói thật cùng các ngươi, nếu các ngươi có đức tin bằng một hột cải, sẽ khiến núi nầy rằng: Hãy dời đây qua đó, thì nó liền dời qua, và không có sự gì mà các ngươi chẳng làm được.",
      "poetic_lines": null,
      "is_paragraph_start": false,
      "is_paragraph_end": true,
      "is_stanza_break": false,
      "is_omitted_in_critical_text": false,
      "section_headings": [],
      "cross_references": [
        {
          "raw": "Mat 21:21",
          "target_usfm": "MAT",
          "target_chapter": 21,
          "target_verses": "21"
        },
        {
          "raw": "Mac 11:23",
          "target_usfm": "MRK",
          "target_chapter": 11,
          "target_verses": "23"
        },
        {
          "raw": "1Co 13:2",
          "target_usfm": "1CO",
          "target_chapter": 13,
          "target_verses": "2"
        }
      ],
