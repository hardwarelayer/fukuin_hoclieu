    {
      "verse_id": "MAT.17.22",
      "verse": 22,
      "text": "Đang khi Đức Chúa Jêsus và môn đồ trải qua trong xứ Ga-li-lê, Ngài phán cùng môn đồ rằng: Con người sẽ bị nộp trong tay người ta.",
      "poetic_lines": null,
      "is_paragraph_start": true,
      "is_paragraph_end": false,
      "is_stanza_break": false,
      "is_omitted_in_critical_text": false,
      "section_headings": [
        {
          "type": "section_scope",
          "text": "(Mac 9:30-32; Lu 9:43b-45)"
        },
        {
          "type": "section_title",
          "text": "Chúa nói trước về sự Ngài chết và sống lại"
        }
      ],
      "cross_references": [],
      "textual_footnotes": [],
      "verification_status": "UNANIMOUS_3_OF_3"
    },
    {
      "verse_id": "MAT.17.23",
      "verse": 23,
      "text": "Họ sẽ giết Ngài, nhưng đến ngày thứ ba Ngài sẽ sống lại. Các môn đồ bèn lo buồn lắm.",
      "poetic_lines": null,
      "is_paragraph_start": false,
      "is_paragraph_end": true,
      "is_stanza_break": false,
      "is_omitted_in_critical_text": false,
      "section_headings": [],
      "cross_references": [],
      "textual_footnotes": [],
      "verification_status": "UNANIMOUS_3_OF_3"
    },
    {
      "verse_id": "MAT.17.24",
      "verse": 24,
      "text": "Khi đã đến thành Ca-bê-na-um, những người thâu thuế của đền thờ đến hỏi Phi-e-rơ rằng: Thầy ngươi có nộp tiền thuế chăng?",
      "poetic_lines": null,
      "is_paragraph_start": true,
      "is_paragraph_end": false,
      "is_stanza_break": false,
      "is_omitted_in_critical_text": false,
      "section_headings": [
        {
          "type": "section_title",
          "text": "Đức Chúa Jêsus nộp thuế"
        }
      ],
      "cross_references": [
        {
          "raw": "Xu 30:13",
          "target_usfm": "EXO",
          "target_chapter": 30,
          "target_verses": "13"
        },
        {
          "raw": "38:26",
          "target_usfm": "EXO",
          "target_chapter": 38,
          "target_verses": "26"
        }
      ],
      "textual_footnotes": [],
      "verification_status": "MAJORITY_HTTLVN_2_OF_3"
    },
    {
      "verse_id": "MAT.17.25",
      "verse": 25,
      "text": "Phi-e-rơ trả lời rằng: Có. Và khi Phi-e-rơ vào nhà, thì Đức Chúa Jêsus hỏi đón trước rằng: Hỡi Si-môn, ngươi nghĩ sao? Các vua thế gian thâu lương lấy thuế ai? Thâu của con trai mình hay là của người ngoài?",
      "poetic_lines": null,
      "is_paragraph_start": false,
      "is_paragraph_end": false,
      "is_stanza_break": false,
      "is_omitted_in_critical_text": false,
      "section_headings": [],
      "cross_references": [],
      "textual_footnotes": [],
      "verification_status": "MAJORITY_HTTLVN_2_OF_3"
    },
    {
      "verse_id": "MAT.17.26",
      "verse": 26,
      "text": "Phi-e-rơ thưa rằng: Người ngoài. Ngài phán rằng: Vậy thì các con trai được miễn thuế!",
      "poetic_lines": null,
      "is_paragraph_start": false,
      "is_paragraph_end": false,
      "is_stanza_break": false,
      "is_omitted_in_critical_text": false,
      "section_headings": [],
      "cross_references": [],
      "textual_footnotes": [],
      "verification_status": "MAJORITY_HTTLVN_2_OF_3"
    },
    {
      "verse_id": "MAT.17.27",
      "verse": 27,
      "text": "Song le, để chúng ta khỏi làm gương xấu cho họ, thì ngươi hãy ra biển câu cá, bắt lấy con cá nào dính câu trước hết, banh miệng nó ra, sẽ thấy một đồng bạc ở trong. Hãy lấy đồng bạc đó, và đem nộp thuế cho ta với ngươi.",
      "poetic_lines": null,
      "is_paragraph_start": false,
      "is_paragraph_end": true,
      "is_stanza_break": false,
      "is_omitted_in_critical_text": false,
      "section_headings": [],
      "cross_references": [],
      "textual_footnotes": [],
      "verification_status": "UNANIMOUS_3_OF_3"
    }
  ]
